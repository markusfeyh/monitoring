[
  {monitoring, []},
  {opentelemetry, [
    {resource, [{service, #{name => "monitoring"}}]},
    {span_processor, batch},
    {traces_exporter, otlp}
  ]},
  %% OTLP over HTTP/protobuf to a local collector or backend
  %% (Jaeger, Grafana Tempo, Zipkin with its OTLP receiver, ...).
  %% Can also be set with OTEL_EXPORTER_OTLP_ENDPOINT.
  {opentelemetry_exporter, [
    {otlp_protocol, http_protobuf},
    {otlp_endpoint, "http://localhost:4318"}
  ]}
].
