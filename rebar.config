{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "~> 2.20"},

    %% Metrics: Prometheus exposition format on /metrics.
    %% prometheus_cowboy 0.2.0 still declares prometheus ~> 5.0, but works
    %% fine with 6.x; listing prometheus here makes rebar3 pick 6.x.
    {prometheus, "~> 6.1"},
    {prometheus_cowboy, "~> 0.2"},

    %% Tracing: OpenTelemetry API + SDK, exported over OTLP.
    {opentelemetry_api, "~> 1.5"},
    {opentelemetry, "~> 1.7"},
    {opentelemetry_exporter, "~> 1.11"},
    {opentelemetry_cowboy, "~> 1.0"},
    {cowboy_telemetry, "~> 0.4"},
    {opentelemetry_process_propagator, "~> 0.3"},

    %% Not used by the code; shipped in the release for debugging a live
    %% node from a remote shell (see README).
    {recon, "~> 2.5"}
]}.

%% The default checks minus exports_not_used: cowboy calls the handler
%% callbacks dynamically, so xref would report them as unused.
{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls]}.

{relx, [{release, {monitoring, "0.1.0"},
         [opentelemetry_exporter,
          {opentelemetry, temporary},
          %% opentelemetry_cowboy 1.0.0 calls otel_http but doesn't list it
          %% in its .app file (fixed upstream, not yet released). Without
          %% this, its telemetry handlers crash on the first request and
          %% get detached, so no server spans are created.
          otel_http,
          monitoring,
          recon,
          sasl]},

        {sys_config, "./config/sys.config"},
        {vm_args, "./config/vm.args"},

        {dev_mode, true},
        {include_erts, false},

        {extended_start_script, true}]
}.

{profiles, [{prod, [{relx, [{dev_mode, false},
                            {include_erts, true}]}]
            }]
}.
